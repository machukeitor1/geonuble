# Copia este archivo a .env.local para desarrollo, y configura las mismas
# variables en Vercel (Settings > Environment Variables) para producción.

# Neon: cadena de conexión (Dashboard > Connect). Sin ella, en local se usa PGlite.
DATABASE_URL=

# Clave larga y aleatoria para firmar las sesiones. Ej: openssl rand -base64 32
JWT_SECRET=

# Administrador inicial (lo crea `npm run db:setup` si la base no tiene usuarios)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Cristian Machuca

# Cloudflare R2 (imágenes). Sin estas variables, en local se guardan en public/uploads/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública del bucket: https://pub-xxxx.r2.dev o un dominio propio
R2_PUBLIC_URL=

# Aviso por correo cuando llega un mensaje del formulario (Resend: resend.com → API Keys).
# Sin dominio verificado, NOTIFY_EMAIL debe ser el mismo correo de tu cuenta de Resend.
RESEND_API_KEY=
# Destino del aviso; varios correos separados por coma (requiere dominio verificado en Resend).
# Si se deja vacío, se usa el email de "Datos de la empresa".
NOTIFY_EMAIL=
# Remitente (opcional). Con dominio verificado, ej: Geoñuble <avisos@geonuble.cl>
MAIL_FROM=

# ── Búsqueda con IA (opcional y gratis) ─────────────────────────────────────
# Sin estas variables la búsqueda funciona igual con el parser por reglas.
# Las claves solo se usan en el servidor; nunca llegan al navegador.

# Proveedor que extrae los filtros: workers-ai | gemini | ollama
LLM_PROVIDER=
# Modelo (opcional). Por defecto: @cf/meta/llama-3.1-8b-instruct (workers-ai),
# gemini-3.5-flash-lite (gemini) o llama3.1:8b (ollama)
LLM_MODEL=
# Gemini: en el plan gratis Google usa el contenido para mejorar sus productos
# (solo se envía el texto de búsqueda, nunca datos de clientes ni corredores)
GEMINI_API_KEY=

# Cloudflare Workers AI (LLM y/o embeddings): Account ID y un token con permiso solo de Workers AI
CF_ACCOUNT_ID=
CF_AI_TOKEN=

# Embeddings para ordenar por similitud: workers-ai | ollama (vacío = orden por palabras)
EMBEDDINGS_PROVIDER=
# Por defecto @cf/baai/bge-m3 (workers-ai) o bge-m3 (ollama)
EMBEDDINGS_MODEL=
# Dimensión del modelo (bge-m3 = 1024). Cambiarla exige recrear la columna embedding.
EMBEDDINGS_DIM=1024

# Ollama local, para correr los evals sin gastar cuota
OLLAMA_URL=http://localhost:11434

# Valor de la UF: CMF (oficial, clave gratis en api.cmfchile.cl); sin ella se usa mindicador.cl
CMF_API_KEY=
# Respaldo si ninguna fuente de la UF responde (ej. 41405)
UF_CLP=
